library(tidyverse)
library(readxl)
library(lubridate)      # Para manejar fechas
library(plotly)         # Gráficos interactivos
library(ggthemes)       # temas
#| echo: false
library(gt)             # Para mostrar las tablas mejor
individual_25_t1 <-
read.table("../bases_eph/usu_individual_T125.txt",
sep = ";",
dec = ",",
header = TRUE,
fill = TRUE )
runif(n = 10,min = -0.99,max = 0.99) # Randomización de numeros basada en una distribución uniforme entre "min y max"
runif(n = 10,min = -0.99,max = 0.99)
set.seed(9999) #Semilla
runif(10,min = 0.01,max = 0.99)
set.seed(9999) #Semilla
runif(10,min = 0.01,max = 0.99)
set.seed(9999) #Semilla
base_con_quintiles <- individual_25_t1 %>%
mutate(PONDIIO = as.numeric(PONDIIO)) %>% # Para evitar Integer Overflow
filter(P21 > 0) %>%
mutate(P21_p  = P21 + runif(nrow(.),
min = -0.99,
max = 0.99)) %>%
mutate(quintil = statar::xtile(x = P21_p,
n = 5,
wt = PONDIIO))
resultado <- base_con_quintiles %>%
group_by(quintil) %>%
summarise(casos = n(),
casos_pondera = sum(PONDIIO),
tasa_feminizacion = sum(PONDIIO[CH04==2])/casos_pondera,
salario_prom = weighted.mean(x = P21,w = PONDIIO))
resultado
aglomerados <- read_excel("../bases_eph/Aglomerados y Regiones EPH.xlsx")
regiones <- read_excel("../bases_eph/Aglomerados y Regiones EPH.xlsx",sheet = "Regiones EPH",skip = 1) # parametro skip = 1, para saltear una fila
salario_y_no_registro <- individual_25_t1 %>%
filter(ESTADO == 1, CAT_OCUP == 3) %>%
group_by(ANO4,TRIMESTRE,REGION,AGLOMERADO) %>%
summarise(tasa_no_reg = sum(PONDERA[PP07H == 2])/sum(PONDERA),
salario_prom = weighted.mean(P21,PONDIIO),
asalariados = sum(PONDERA)) %>%
ungroup() %>%
left_join(aglomerados,by = c("AGLOMERADO")) %>%
left_join(regiones,by = c("REGION"))
salario_y_no_registro
ggplot(data = salario_y_no_registro,
aes(x = salario_prom,
y = tasa_no_reg,
size = asalariados,
color = Region))+
geom_point()+
labs(title = "Salario promedio y tasa de no registro por aglomerados",
subtitle = "31 Aglomerados. 1er Trimestre de 2025.",
x = "Salario promedio",
y = "Tasa de no registro")+
theme_minimal()+
guides(size = F)+
scale_y_continuous(labels = scales::percent_format(accuracy = 1))+
scale_x_continuous(labels = scales::number_format(big.mark = ".",decimal.mark = ","))
capa1 <- ggplot(data = salario_y_no_registro,
aes(x = salario_prom,
y = tasa_no_reg,
size = asalariados,
color = Region))
capa1
capa2 <- capa1 +
geom_point()
capa2
capa3 <- capa2 +
labs(title = "Salario promedio y tasa de no registro por aglomerados",
subtitle = "31 Aglomerados. 1er Trimestre de 2025.",
x = "Salario promedio",
y = "Tasa de no registro")
capa3
grafico_final <- capa3 +
theme_minimal()+
guides(size = FALSE)+
scale_y_continuous(labels = scales::percent_format(accuracy = 1))+
scale_x_continuous(labels = scales::number_format(big.mark = ".",decimal.mark = ","))
grafico_final
