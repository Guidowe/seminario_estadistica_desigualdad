reldist::gini(ocupados_con_ingreso$P21,ocupados_con_ingreso$PONDIIO)
## -----------------------------------------------------------------------------------------
gini_por_sexo <- ocupados_con_ingreso %>%
group_by(Sexo) %>%
summarise(casos          = n(),
poblacion      = sum(PONDIIO),
ingreso_medio  = weighted.mean(P21, PONDIIO),
gini           = reldist::gini(P21, PONDIIO),
.groups = "drop")
View(gini_por_sexo)
