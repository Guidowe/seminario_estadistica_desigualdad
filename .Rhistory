cat(paste0("  ", incluir, collapse = "\n"), "\n\n")
}
.habilitar_en_web <- function(n) {
if (!file.exists("index.html")) {
warning("No encuentro index.html: no habilite el boton.", call. = FALSE)
return(invisible())
}
html <- readLines("index.html", encoding = "UTF-8", warn = FALSE)
i <- grep(sprintf("\\{ n: %d,", n), html)
if (length(i) != 1) {
warning("No encuentro la clase ", n, " en la lista CLASES de index.html.",
call. = FALSE)
} else if (grepl("disponible: true", html[i])) {
cat("La clase", n, "ya estaba habilitada en index.html.\n")
} else {
html[i] <- sub("disponible: false", "disponible: true ", html[i])
writeLines(html, "index.html", useBytes = TRUE)
cat("Boton de la clase", n, "habilitado en index.html.\n")
}
}
armar_zip_clase(5)
add.percentage = "col")
armar_zip_clase(5)
# =============================================================================
# CLASE 05 -- Deciles de ingreso per capita familiar (IPCF)
# EPH, 1er trimestre de 2026
#
# Que hace este script:
#   1. Carga las bases individual y de hogares del 1T 2026.
#   2. Arma deciles de IPCF a nivel individual (personas) y a nivel hogares.
#   3. Muestra, para cada decil, la media y la mediana del IPCF.
#   4. Calcula la brecha 10/1 del ingreso promedio en cada caso.
#
# Ponderador: PONDIH (corrige la no respuesta de ingresos del hogar).
# Solo se usan casos con PONDIH positivo.
#
# ANTES DE EMPEZAR:
#   Abri el proyecto con doble clic en "seminario.Rproj".
#   Las bases tienen que estar en bases_eph/ con los nombres de INDEC:
#     bases_eph/usu_individual_T126.txt
#     bases_eph/usu_hogar_T126.txt
#   Si no estan, el script intenta bajarlas con el paquete eph.
# =============================================================================
# ---- Paquetes ---------------------------------------------------------------
library(tidyverse)
library(statar)    # xtile(): construye cuantiles ponderados
library(reldist)   # wtd.quantile(): mediana ponderada
# ---- 1. Carga de las bases --------------------------------------------------
ruta_ind <- "bases_eph/usu_individual_T126.txt"
ruta_hog <- "bases_eph/usu_hogar_T126.txt"
if (file.exists(ruta_ind) & file.exists(ruta_hog)) {
individual_26_t1 <- read.table(ruta_ind, sep = ";", dec = ",",
header = TRUE, fill = TRUE)
hogar_26_t1      <- read.table(ruta_hog, sep = ";", dec = ",",
header = TRUE, fill = TRUE)
} else {
# Plan B: descarga desde el repositorio del paquete eph
individual_26_t1 <- eph::get_microdata(year = 2026, trimester = 1,
type = "individual")
hogar_26_t1      <- eph::get_microdata(year = 2026, trimester = 1,
type = "hogar")
}
# ---- 2. Deciles a nivel INDIVIDUAL ------------------------------------------
# Cada persona recibe el IPCF de su hogar. El decil se arma ordenando a las
# PERSONAS por IPCF, de modo que cada decil reune ~10% de la poblacion.
personas_deciles <- individual_26_t1 %>%
mutate(PONDIH = as.numeric(PONDIH)) %>%   # Para evitar Integer Overflow
filter(PONDIH > 0) %>%
mutate(decil = xtile(x = IPCF, n = 10, wt = PONDIH))
tabla_personas <- personas_deciles %>%
group_by(decil) %>%
summarise(casos         = n(),
poblacion     = sum(PONDIH),
ipcf_media    = weighted.mean(x = IPCF, w = PONDIH),
ipcf_mediana  = wtd.quantile(x = IPCF, q = 0.5, weight = PONDIH),
.groups = "drop") %>%
mutate(part_poblacion = poblacion / sum(poblacion))
tabla_personas
# ---- 3. Deciles a nivel HOGARES ---------------------------------------------
# Ahora la unidad es el hogar: cada decil reune ~10% de los HOGARES.
# Como los hogares pobres tienen en promedio mas miembros, los cortes de
# los deciles no coinciden con los de personas.
hogares_deciles <- hogar_26_t1 %>%
mutate(PONDIH = as.numeric(PONDIH)) %>%
filter(PONDIH > 0) %>%
mutate(decil = xtile(x = IPCF, n = 10, wt = PONDIH))
tabla_hogares <- hogares_deciles %>%
group_by(decil) %>%
summarise(casos         = n(),
hogares       = sum(PONDIH),
ipcf_media    = weighted.mean(x = IPCF, w = PONDIH),
ipcf_mediana  = wtd.quantile(x = IPCF, q = 0.5, weight = PONDIH),
.groups = "drop") %>%
mutate(part_hogares = hogares / sum(hogares))
tabla_hogares
# ---- 4. Brecha 10/1 del ingreso promedio ------------------------------------
# Cuantas veces el IPCF promedio del decil 10 supera al del decil 1.
brecha_personas <- tabla_personas %>%
summarise(ipcf_d1     = ipcf_media[decil == 1],
ipcf_d10    = ipcf_media[decil == 10],
brecha_10_1 = ipcf_d10 / ipcf_d1) %>%
mutate(nivel = "Personas", .before = 1)
brecha_hogares <- tabla_hogares %>%
summarise(ipcf_d1     = ipcf_media[decil == 1],
ipcf_d10    = ipcf_media[decil == 10],
brecha_10_1 = ipcf_d10 / ipcf_d1) %>%
mutate(nivel = "Hogares", .before = 1)
brechas <- bind_rows(brecha_personas, brecha_hogares)
brechas
# ---- (Opcional) Exportar ----------------------------------------------------
# openxlsx::write.xlsx(list(personas = tabla_personas,
#                           hogares  = tabla_hogares,
#                           brechas  = brechas),
#                      file = "Resultados/deciles_ipcf_1T2026.xlsx")
View(tabla_hogares)
View(tabla_personas)
View(tabla_hogares)
View(personas_deciles)
View(tabla_personas)
