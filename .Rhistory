library(tidyverse)
library(openxlsx)
library(eph)
library(scales)
list.files("bases_eph/")
individual_25_t1 <-
read.table("bases_eph/usu_individual_T125.txt",
sep = ";",
dec = ",",
header = TRUE,
fill = TRUE )
Aglom <- openxlsx::read.xlsx("bases_eph/Aglomerados y Regiones EPH.xlsx")
Datos  <- individual_25_t1[
c("AGLOMERADO","MAS_500",
"CH04","CH06","NIVEL_ED",
"P47T","PONDERA","PONDII")]
frecuencias_mas500<- table(
individual_25_t1$MAS_500,useNA = "always")
frecuencias_mas500
prop.table(frecuencias_mas500)
table(Datos$NIVEL_ED)
Datos$NIVEL_ED[Datos$NIVEL_ED==7] <- 1
table(Datos$NIVEL_ED)
Datos_etiquetados <- eph::organize_labels(Datos)
table(Datos_etiquetados$NIVEL_ED,useNA = "always")
hist(Datos$NIVEL_ED)
table(Datos$MAS_500,Datos$CH04)
eph::calculate_tabulates(base = Datos,x = "MAS_500",y = "CH04",weights = "PONDERA",add.totals = "both")
summary(Datos)
Datos$CH06[Datos$CH06==-1] <- 0
edad_prom<- mean(Datos$CH06)
edad_prom_pond <- weighted.mean(Datos$CH06,Datos$PONDERA)
edad_prom_pond
median(Datos$CH06)
get_mode <- function(x) {
uniq_x <- unique(x)
uniq_x[which.max(tabulate(match(x, uniq_x)))]
}
get_mode(Datos$CH06)
