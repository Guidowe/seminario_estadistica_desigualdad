# =============================================================================
# build.R  --  genera los materiales que reciben los estudiantes
#
# USO DOCENTE. Se corre desde la raiz del proyecto:
#
#     source("_docente/build.R")
#
# Que hace, para cada clases/NN_tema/NN_tema.qmd:
#
#   1. RENDERIZA  -> NN_tema.html   (lo que los estudiantes LEEN)
#   2. PURL       -> NN_tema.R      (lo que los estudiantes CORREN)
#
# Los dos salen del MISMO archivo fuente. Por eso nunca se desincronizan:
# no hay forma de arreglar algo en el documento y olvidarse del script.
#
# Sobre el paso 2 (purl): knitr::purl() extrae los chunks de codigo del .qmd
# y descarta el texto. Los chunks marcados con  #| purl: false  quedan afuera:
# usalo para las imagenes decorativas y para los chunks ocultos que existen
# solo para que el HTML muestre un resultado.
#
# Opcional:
#   source("_docente/build.R")            # todas las clases
#   build(clases = "01")                  # una sola
#   build(clases = c("01","02"), html = FALSE)   # solo regenerar los .R
# =============================================================================
build <- function(clases = NULL, html = TRUE, scripts = TRUE) {
# ---- Controles previos ----------------------------------------------------
if (!file.exists("seminario.Rproj")) {
stop("Corre esto desde la raiz del proyecto (abri seminario.Rproj).",
call. = FALSE)
}
if (!requireNamespace("knitr", quietly = TRUE)) {
stop("Falta el paquete 'knitr'. Instalalo con install.packages('knitr').",
call. = FALSE)
}
if (html && Sys.which("quarto") == "") {
warning("No encuentro el comando 'quarto' en el PATH.\n",
"  Instalalo desde https://quarto.org/docs/get-started/\n",
"  Por ahora genero solo los scripts .R.", call. = FALSE)
html <- FALSE
}
# ---- Que clases procesamos ------------------------------------------------
fuentes <- list.files("clases", pattern = "\\.qmd$",
recursive = TRUE, full.names = TRUE)
if (!is.null(clases)) {
patron <- paste0("clases/(", paste(clases, collapse = "|"), ")")
fuentes <- fuentes[grepl(patron, fuentes)]
}
if (length(fuentes) == 0) {
stop("No encontre ningun .qmd para procesar.", call. = FALSE)
}
cat("\n=============================================================\n")
cat("  BUILD --", length(fuentes), "clase(s)\n")
cat("=============================================================\n\n")
errores <- character(0)
for (qmd in fuentes) {
nombre <- basename(qmd)
cat("---", nombre, "---\n")
# ---- 1. HTML (lo que leen) ---------------------------------------------
if (html) {
cat("  [html]   renderizando... ")
res <- suppressWarnings(
system2("quarto", c("render", shQuote(qmd)),
stdout = TRUE, stderr = TRUE)
)
estado <- attr(res, "status")
if (!is.null(estado) && estado != 0) {
cat("FALLO\n")
errores <- c(errores, qmd)
cat("    ", paste(utils::tail(res, 12), collapse = "\n     "), "\n")
} else {
cat("ok\n")
}
}
# ---- 2. Script .R (lo que corren) ---------------------------------------
if (scripts) {
cat("  [script] extrayendo codigo... ")
salida <- sub("\\.qmd$", ".R", qmd)
ok <- tryCatch({
knitr::purl(input = qmd, output = salida,
documentation = 1, quiet = TRUE)
TRUE
}, error = function(e) {
cat("FALLO\n     ", conditionMessage(e), "\n")
errores <<- c(errores, qmd)
FALSE
})
if (isTRUE(ok)) {
encabezar_script(salida, nombre)
n <- length(readLines(salida, warn = FALSE))
cat("ok (", n, " lineas)\n", sep = "")
}
}
cat("\n")
}
# ---- Cierre ---------------------------------------------------------------
cat("=============================================================\n")
if (length(errores) == 0) {
cat("  Listo. Materiales generados sin errores.\n")
cat("  Conviene correr ahora:  source('_docente/chequear_rutas.R')\n")
} else {
cat("  Terminado CON ERRORES en:\n")
for (e in unique(errores)) cat("    -", e, "\n")
}
cat("=============================================================\n\n")
invisible(errores)
}
# ---- Encabezado de los scripts del estudiante -------------------------------
#
# El .R que sale de purl() arranca directo con codigo. Le agregamos adelante
# las instrucciones minimas, porque este archivo lo va a abrir alguien que
# quizas nunca abrio RStudio.
encabezar_script <- function(ruta, nombre_fuente) {
cuerpo <- readLines(ruta, warn = FALSE, encoding = "UTF-8")
cabecera <- c(
"# ===========================================================================",
"# SEMINARIO: Estadistica y programacion para estudios del trabajo,",
"#            desigualdad y pobreza -- Doctorado en Ciencias Sociales (UBA)",
"#",
"# Este es el codigo de la clase, sin el texto explicativo.",
"# La explicacion completa esta en el archivo .html que acompania a este",
"# script: abrilo en el navegador y tenelo al lado mientras trabajas.",
"#",
"# ANTES DE CORRER NADA:",
"#   Abri el proyecto haciendo doble clic en 'seminario.Rproj'.",
"#   Si abriste este archivo suelto, R no va a encontrar las bases de datos.",
"#",
"# COMO SE EJECUTA:",
"#   Para el cursor en una linea y apreta Ctrl + Enter (Cmd + Enter en Mac).",
"#   Se corre esa linea y el cursor baja a la siguiente. De a una, sin apuro.",
"#",
"# NO EDITES ESTE ARCHIVO PENSANDO QUE SE GUARDA:",
"#   se regenera automaticamente a partir de la fuente. Si queres tomar",
"#   notas, guardalo con otro nombre (por ejemplo 'mis_notas_clase1.R').",
"# ===========================================================================",
"",
paste0("# [generado automaticamente desde ", nombre_fuente,
" el ", format(Sys.Date(), "%d/%m/%Y"), "]"),
""
)
writeLines(c(cabecera, cuerpo), ruta, useBytes = TRUE)
}
build(clases = c("01"), html = FALSE)
source('_docente/chequear_rutas.R')
build(clases = c("01"), html = FALSE)
source('_docente/chequear_rutas.R')
