summarise(
"Sin descuento jubilatorio" = weighted.mean(d_registro, PONDERA) * 100,
"Part-time involuntario"    = weighted.mean(d_part_time,  PONDERA) * 100,
"Tiempo determinado"        = weighted.mean(d_finalizacion, PONDERA) * 100) %>%
round(1)
